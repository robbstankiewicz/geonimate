        "../../timeline/src/core/providers/scale-values.provider.ts",
        "../../timeline/src/core/store/timeline.store.ts",
        "../../timeline/src/core/store/timeline.store.spec.ts",
        "../../config/src/core/store/config.store.ts",
        "../../config/src/core/store/config.store.spec.ts",
        "../../map/src/core/store/map.store.ts",
        "../../map/src/core/store/map.store.spec.ts",
        "../../../apps/design/src/core/services/manager.service.ts"
    ],
