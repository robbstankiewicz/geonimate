{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../../dist/out-tsc",
        "module": "preserve",
        "target": "es2016",
        "types": ["jest", "node"],
        "lib": ["es2023", "es2020", "dom"],
        "moduleResolution": "bundler",
        "isolatedModules": true
    },
    "files": ["src/test-setup.ts"],
    "include": [
        "jest.config.ts",
