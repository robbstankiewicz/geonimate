{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../../dist/out-tsc",
        "declaration": true,
        "declarationMap": true,
        "inlineSources": true,
        "lib": ["es2023", "es2020", "dom"],
        "types": []
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
    "references": [
        {
            "path": "../core/tsconfig.lib.json"
        },
        {
            "path": "../utils/tsconfig.lib.json"
        }
    ]
}
