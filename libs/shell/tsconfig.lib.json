{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "declaration": true,
        "declarationMap": true,
        "inlineSources": true,
        "types": []
    },
    "include": ["src/**/*.ts"],
    "exclude": [
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "jest.config.ts",
        "jest.config.cts",
        "src/test-setup.ts"
    ],
    "references": [
        {
            "path": "../../libs/map/tsconfig.lib.json"
        },
        {
            "path": "../../libs/shared/core/tsconfig.lib.json"
        },
        {
            "path": "../../libs/shared/manager/tsconfig.lib.json"
        },
        {
            "path": "../../libs/demos/tsconfig.lib.json"
        }
    ]
}
