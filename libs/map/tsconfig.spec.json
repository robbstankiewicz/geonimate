{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "module": "preserve",
        "target": "es2016",
        "lib": ["es2023", "es2020", "dom"],
        "types": ["jest", "node"],
        "moduleResolution": "bundler",
        "isolatedModules": true
    },
    "files": ["src/test-setup.ts"],
    "include": [
        "jest.config.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.ts",
        "src/**/*.d.ts"
    ],
    "references": [
        {
            "path": "../shared/core/tsconfig.lib.json"
        }
    ]
}
