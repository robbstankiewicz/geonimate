{
    "name": "player",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "app",
    "sourceRoot": "apps/player/src",
    "tags": [
        "--scope=player",
        "--type=app"
    ],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "outputs": [
                "{options.outputPath}"
            ],
            "options": {
                "outputPath": "dist/apps/player",
                "browser": "apps/player/src/main.ts",
                "tsConfig": "apps/player/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "apps/player/public"
                    }
                ],
                "styles": [
                    "apps/player/src/styles.scss"
                ]
            },
            "configurations": {
                "production": {
                    "fileReplacements": [
                        {
                            "replace": "libs/shared/core/src/environments/environment.ts",
                            "with": "libs/shared/core/src/environments/environment.prod.ts"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "continuous": true,
            "executor": "@angular/build:dev-server",
            "configurations": {
                "production": {
                    "buildTarget": "player:build:production"
                },
                "development": {
                    "buildTarget": "player:build:development"
                }
            },
            "defaultConfiguration": "development"
        },
        "extract-i18n": {
            "executor": "@angular/build:extract-i18n",
            "options": {
                "buildTarget": "player:build"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": [
                "{workspaceRoot}/coverage/{projectRoot}"
            ],
            "options": {
                "jestConfig": "apps/player/jest.config.ts",
                "tsConfig": "apps/player/tsconfig.spec.json"
            }
        },
        "serve-static": {
            "continuous": true,
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "player:build",
                "staticFilePath": "dist/apps/player/browser",
                "spa": true
            }
        }
    }
}
