{
    "name": "design",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "app",
    "sourceRoot": "apps/design/src",
    "tags": ["--scope=design", "--type=app"],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/design",
                "browser": "apps/design/src/main.ts",
                "tsConfig": "apps/design/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "apps/design/public"
                    }
                ],
                "styles": ["apps/design/src/styles.scss"]
            },
            "configurations": {
                "production": {
                    "fileReplacements": [
                        {
                            "replace": "libs/shared/core/src/environments/environment.ts",
                            "with": "libs/shared/core/src/environments/environment.prod.ts"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "continuous": true,
            "executor": "@angular/build:dev-server",
            "configurations": {
                "production": {
                    "buildTarget": "design:build:production"
                },
                "development": {
                    "buildTarget": "design:build:development"
                }
            },
            "defaultConfiguration": "development"
        },
        "extract-i18n": {
            "executor": "@angular/build:extract-i18n",
            "options": {
                "buildTarget": "design:build"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "apps/design/jest.config.ts",
                "tsConfig": "apps/design/tsconfig.spec.json"
            }
        },
        "serve-static": {
            "continuous": true,
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "design:build",
                "staticFilePath": "dist/apps/design/browser",
                "spa": true
            }
        }
    }
}
